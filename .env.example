PORT=4001
PUBLIC_BASE_URL=http://localhost:4001

# sandbox | production
QPAY_ENV=sandbox
QPAY_CLIENT_ID=your_qpay_client_id
QPAY_CLIENT_SECRET=your_qpay_client_secret
QPAY_INVOICE_CODE=your_qpay_invoice_code

# Public URL QPay can call after payment, e.g. https://your-domain.mn/api/qpay/callback
QPAY_CALLBACK_URL=http://localhost:4001/api/qpay/callback

# Shopify webhook/API integration
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_app_client_secret
# Optional legacy/admin-created custom app token.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_API_VERSION=2026-07

# Shopify manual payment webhooks often arrive as "manual".
SHOPIFY_QPAY_GATEWAY_NAMES=qpay,manual

# Keep false first. Turn true only after testing transaction creation on your store.
SHOPIFY_MARK_PAID=false
